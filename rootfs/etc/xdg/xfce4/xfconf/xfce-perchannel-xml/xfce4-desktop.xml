<?xml version="1.0" encoding="UTF-8"?>
<!-- OpenFang OS — XFCE4 Desktop Configuration -->
<channel name="xfce4-desktop" version="1.0">
  <property name="desktop-icons" type="empty">
    <property name="style" type="int" value="2"/>
    <property name="icon-size" type="uint" value="52"/>
    <property name="tooltip-size" type="double" value="128"/>
    <property name="use-custom-font-size" type="bool" value="true"/>
    <property name="custom-font-size" type="double" value="12"/>
    <property name="show-thumbnails" type="bool" value="true"/>
    <property name="show-hidden-files" type="bool" value="false"/>
    <property name="center-text" type="bool" value="true"/>
    <property name="show-home" type="bool" value="true"/>
    <property name="show-filesystem" type="bool" value="true"/>
    <property name="show-trash" type="bool" value="true"/>
    <property name="show-removable" type="bool" value="true"/>
  </property>
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <!-- Virtual / QEMU display -->
      <property name="monitorVirtual-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/openfang/wallpaper.png"/>
        </property>
      </property>
      <!-- HDMI output -->
      <property name="monitorHDMI-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/openfang/wallpaper.png"/>
        </property>
      </property>
      <!-- DisplayPort output -->
      <property name="monitorDP-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/openfang/wallpaper.png"/>
        </property>
      </property>
      <!-- Laptop internal display -->
      <property name="monitoreDP-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/openfang/wallpaper.png"/>
        </property>
      </property>
      <!-- VGA output -->
      <property name="monitorVGA-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/openfang/wallpaper.png"/>
        </property>
      </property>
    </property>
  </property>
</channel>
