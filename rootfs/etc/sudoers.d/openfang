# OpenFang OS — sudo rules
# Allow 'ai' user to run installer and service management without password

# Service management (for openfang-ctl restart)
ai ALL=(root) NOPASSWD: /usr/bin/systemctl start openfang
ai ALL=(root) NOPASSWD: /usr/bin/systemctl stop openfang
ai ALL=(root) NOPASSWD: /usr/bin/systemctl restart openfang
ai ALL=(root) NOPASSWD: /usr/bin/systemctl status openfang
ai ALL=(root) NOPASSWD: /usr/bin/systemctl enable openfang
ai ALL=(root) NOPASSWD: /usr/bin/systemctl start lightdm
ai ALL=(root) NOPASSWD: /usr/bin/systemctl restart lightdm

# Firewall management
ai ALL=(root) NOPASSWD: /usr/sbin/ufw *
ai ALL=(root) NOPASSWD: /usr/sbin/nft *

# Installer
ai ALL=(root) NOPASSWD: /usr/lib/openfang/install.sh
ai ALL=(root) NOPASSWD: /usr/share/openfang/installer/install.sh

# Package updates
ai ALL=(root) NOPASSWD: /usr/bin/apt-get update
ai ALL=(root) NOPASSWD: /usr/bin/apt-get -y upgrade
ai ALL=(root) NOPASSWD: /usr/bin/apt-get -y dist-upgrade

# Config file access
ai ALL=(root) NOPASSWD: /usr/bin/tee /etc/openfang/config.toml
