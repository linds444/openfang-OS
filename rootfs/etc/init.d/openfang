#!/sbin/openrc-run
# OpenFang OS — OpenFang Agent Runtime Init Script (OpenRC)

name="openfang"
description="OpenFang AI Agent Runtime"
command="/usr/bin/openfang"
command_args="--config /etc/openfang/config.toml"
command_user="openfang:openfang"
command_background=true
pidfile="/run/openfang/openfang.pid"
output_log="/var/log/openfang/openfang.log"
error_log="/var/log/openfang/openfang-error.log"

supervisor=supervise-daemon

required_files="/etc/openfang/config.toml"

depend() {
    need net
    need syslog
    after apparmor
    use logger
}

start_pre() {
    # Create runtime directories
    checkpath -d -m 0750 -o openfang:openfang /run/openfang
    checkpath -d -m 0750 -o openfang:openfang /var/log/openfang
    checkpath -d -m 0750 -o openfang:openfang /var/log/openfang/agents
    checkpath -d -m 0750 -o openfang:openfang /data/openfang
    checkpath -d -m 0750 -o openfang:openfang /etc/openfang/agents

    # Apply kernel hardening
    sysctl -p /etc/sysctl.d/99-openfang-hardening.conf >/dev/null 2>&1 || true

    # Load AppArmor profiles
    if rc-service apparmor status >/dev/null 2>&1; then
        apparmor_parser -r /etc/apparmor.d/openfang 2>/dev/null || true
    fi

    # Validate config
    if [ ! -f /etc/openfang/config.toml ]; then
        ewarn "No config found at /etc/openfang/config.toml"
        ewarn "Copying default config..."
        cp /etc/openfang/config.toml.default /etc/openfang/config.toml 2>/dev/null || true
    fi
}

start_post() {
    # Wait for API to be ready
    local retries=30
    while [ $retries -gt 0 ]; do
        if curl -sf http://127.0.0.1:8080/health >/dev/null 2>&1; then
            einfo "OpenFang API ready at http://127.0.0.1:8080"
            return 0
        fi
        sleep 1
        retries=$((retries - 1))
    done
    ewarn "OpenFang API did not become ready in 30s"
}

stop_post() {
    rm -f /run/openfang/openfang.pid
}
