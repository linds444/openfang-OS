# OpenFang OS — Linux 6.6 LTS Kernel Configuration
# Security-hardened, minimal footprint, AI-workload optimized
#
# Based on: Linux 6.6.x LTS
# Target:   x86_64 (generic 64-bit PC)
# Profile:  Server/embedded — no GUI, minimal drivers
#
# To use:
#   cd /usr/src/linux-6.6.x
#   cp /path/to/this/config-6.6 .config
#   make olddefconfig
#   make -j$(nproc)

# ─── Architecture ─────────────────────────────────────────────────────────────
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256
CONFIG_NUMA=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# ─── CPU Features ─────────────────────────────────────────────────────────────
CONFIG_GENERIC_CPU=y
CONFIG_X86_FEATURE_NAMES=y
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
CONFIG_MICROCODE_AMD=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_MTRR=y

# ─── Memory ───────────────────────────────────────────────────────────────────
CONFIG_HIGHMEM64G=y
CONFIG_X86_PAE=y
CONFIG_SPARSEMEM_VMEMMAP=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_ZSWAP=y
CONFIG_ZSMALLOC=y
CONFIG_BALLOON_COMPACTION=y
CONFIG_MEMORY_BALLOON=y

# ─── Security Hardening ───────────────────────────────────────────────────────
# KASLR
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# Stack protector
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y

# SMEP/SMAP (prevent kernel from executing/accessing user memory)
CONFIG_X86_SMEP=y
CONFIG_X86_SMAP=y

# Control Flow Integrity
CONFIG_X86_CET=y
CONFIG_CFI_CLANG=n  # GCC-based build

# Heap/memory hardening
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_PAGE_SANITIZE=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# Kernel lockdown
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE is not set
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y

# Restrict /dev/mem and /dev/kmem
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
# CONFIG_DEVKMEM is not set

# Module signing
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y

# Disable kexec (prevents loading new kernels without reboot)
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set

# Disable hibernation (can expose RAM contents)
# CONFIG_HIBERNATION is not set

# Restrict ptrace
CONFIG_SECURITY_YAMA=y
CONFIG_DEFAULT_SECURITY_YAMA=y

# Hardened usercopy
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_FALLBACK=n

# Fortify source
CONFIG_FORTIFY_SOURCE=y

# Bounds checking
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_MISC=n

# ─── LSM / MAC ────────────────────────────────────────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_SELINUX=n  # Use AppArmor instead
CONFIG_LSM="lockdown,yama,apparmor,bpf"

# Capabilities
CONFIG_MULTIUSER=y
CONFIG_SECURITY_FILE_CAPABILITIES=y

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ─── Networking ───────────────────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NFT_FILTER=y
CONFIG_NFT_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y

# Network security
CONFIG_SYN_COOKIES=y
# CONFIG_INET_DIAG_DESTROY is not set

# ─── Filesystems ──────────────────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Encryption
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y

# ─── Block / Storage ──────────────────────────────────────────────────────────
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_AHCI=y
CONFIG_SATA_AHCI=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_STORAGE=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_SCSI=y

# DM / LUKS
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_DM_VERITY=y
CONFIG_DM_SNAPSHOT=y

# ─── Crypto ───────────────────────────────────────────────────────────────────
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_SHA3=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_DRBG_HMAC=y
CONFIG_CRYPTO_DRBG=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_HW_RANDOM_INTEL=y

# ─── Virtualization ───────────────────────────────────────────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_RNG=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_HYPERVISOR_GUEST=y

# ─── Namespaces & Cgroups (for agent sandboxing) ──────────────────────────────
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y

# ─── eBPF (for monitoring and security) ───────────────────────────────────────
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_LSM=y
CONFIG_NETFILTER_XT_MATCH_BPF=y

# ─── USB & Input ──────────────────────────────────────────────────────────────
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ─── Graphics (minimal — console only) ────────────────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
CONFIG_DRM_VIRTIO_GPU=y  # For QEMU

# ─── TPM2 ─────────────────────────────────────────────────────────────────────
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_TCG_VIRTIO_VTPM=y

# ─── Kernel debugging (disabled for production) ───────────────────────────────
# CONFIG_KGDB is not set
# CONFIG_DEBUG_KERNEL is not set
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=30

# ─── Build metadata ───────────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-openfang"
CONFIG_DEFAULT_HOSTNAME="openfang"
CONFIG_BUILD_SALT=""
